{
  "name": "dandelion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "db:local": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute DB --remote --file=./schema.sql"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "hono": "^4.6.0",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true
  }
}
